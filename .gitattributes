* text=auto
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.sh text eol=lf
# Generated SDKs and their templates must match byte-for-byte on every platform.
sdk/typescript/*.ts text eol=lf
crates/keel-api/src/typescript_transport.txt text eol=lf
*.ps1 text eol=crlf
*.png binary
*.pdf binary
*.docx binary
*.xlsx binary
*.ico binary
*.heic binary
*.avif binary
*.dng binary
# Fuzz seeds are byte-exact inputs.
fuzz/corpus/** -text
fuzz/corpus/efu/* -text
